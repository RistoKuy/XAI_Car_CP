# Salin ke .env lalu isi nilai lokal (jangan commit .env)
# Database
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/carprice
POSTGRES_DB=carprice
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
API_PORT=8000
CORS_ORIGINS=http://localhost,http://localhost:80
MODEL_DIR=./artifacts/models/xgboost/xgb-v1
MODEL_VERSION=xgb-v1
INFERENCE_TIMEOUT_S=10

# ML / Training
RANDOM_SEED=42
DATASET_PATH=./dataset.csv
ARTIFACT_ROOT=./artifacts/models/xgboost
