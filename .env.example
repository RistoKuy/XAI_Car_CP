# Salin ke .env lalu isi nilai lokal (jangan commit .env).
# Default bawah = mode PASSWORDLESS lokal: Postgres trust-auth + pgAdmin tanpa login.
# Buka pgAdmin: http://localhost:5050 -> server "carprice (local)" langsung terhubung.

# --- Password (kosong = passwordless lokal) ---
# Postgres: tanpa password bila POSTGRES_HOST_AUTH_METHOD=trust.
# pgAdmin: desktop mode (PGADMIN_CONFIG_SERVER_MODE=False) = tanpa layar login.
# Bila butuh password (mis. server bersama/prod):
#   1. Isi POSTGRES_PASSWORD=... + POSTGRES_HOST_AUTH_METHOD=scram-sha-256
#   2. DATABASE_URL=postgresql+psycopg://app:<sama>@postgres:5432/carprice
#   3. pgAdmin: hapus PGADMIN_CONFIG_SERVER_MODE (kembali mode login) dan
#      tambah server manual host=postgres user=app password=<sama>.
DATABASE_URL=postgresql+psycopg://app@postgres:5432/carprice
POSTGRES_DB=carprice
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_HOST_AUTH_METHOD=trust
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# pgAdmin (tanpa login bila PGADMIN_CONFIG_SERVER_MODE=False)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@carprice.app
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_CONFIG_SERVER_MODE=False
# Izinkan domain lokal (.test) sebagai email pgAdmin
PGADMIN_CONFIG_GLOBALLY_DELIVERABLE=False
# Backend
API_PORT=8000
CORS_ORIGINS=http://localhost,http://localhost:80
MODEL_DIR=./artifacts/models/xgboost/xgb-v1
MODEL_VERSION=xgb-v1
INFERENCE_TIMEOUT_S=10

# ML / Training
RANDOM_SEED=42
DATASET_PATH=./dataset.csv
ARTIFACT_ROOT=./artifacts/models/xgboost
DATASET_NAME=carprice-used
# Seed tabel listings saat backend start bila kosong (false = matikan)
SEED_ON_STARTUP=true
SEED_CSV_PATH=./data/processed/used_filtered.csv
# Fallback bila file filter belum ada (fresh clone tanpa profile_dataset.py):
# seed_from_csv memfilter Bekas/Used sendiri, jadi dataset.csv mentah bisa dipakai langsung.
SEED_FALLBACK_CSV_PATH=/app/dataset.csv
