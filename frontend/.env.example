# Kosong = same-origin /api/v1 (mode Nginx, tanpa hardcode host).
# Dev lokal via `npm run dev` memakai proxy Vite ke http://localhost:8000.
VITE_API_URL=
VITE_API_TIMEOUT_MS=20000
# URL absolut User Portal untuk link "Kembali" di Developer Portal.
# Kosong = host saat ini tanpa port (port 80 produksi).
# Dev lokal via `npm run dev`: isi http://localhost:5173
VITE_USER_PORTAL_URL=
